# Backend
DATABASE_URL=postgresql+asyncpg://sentinelgrid:sentinelgrid@localhost:5432/sentinelgrid
DEBUG=false
CORS_ORIGINS=["http://localhost:5173"]

# AI agents (optional — offline_mode=true runs deterministic agents without calling LLMs)
OFFLINE_MODE=true
BEDROCK_REGION=us-east-1

